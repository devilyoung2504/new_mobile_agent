{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {
    "azure_devops": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "ado_mcp_project=\"$AZURE_DEVOPS_MCP_PROJECT\" exec npx -y @azure-devops/mcp \"$AZURE_DEVOPS_MCP_ORG\" --authentication azcli -d core work-items repositories search"
      ],
      "enabled": true,
      "timeout": 30000
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
